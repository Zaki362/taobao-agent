DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_DISABLED=false
# Optional task-level budgets for the complete HTTP response, including body reads.
DEEPSEEK_REQUEST_TIMEOUT_MS=
DEEPSEEK_PARSE_TIMEOUT_MS=15000
DEEPSEEK_PLAN_TIMEOUT_MS=26000
DEEPSEEK_REFINE_TIMEOUT_MS=18000
DEEPSEEK_PLAN_REVIEW_TIMEOUT_MS=10000
DEEPSEEK_CANDIDATE_REVIEW_TIMEOUT_MS=8000
DEEPSEEK_AGENT_DECISION_TIMEOUT_MS=8000
DEEPSEEK_AGENT_CHAT_TIMEOUT_MS=8000
DEEPSEEK_AGENT_REASONER_TIMEOUT_MS=15000
DEEPSEEK_BUNDLE_TIMEOUT_MS=12000
DEEPSEEK_EXPLAIN_TIMEOUT_MS=6000
SCENECART_PRODUCT_MODE=development
ALLOW_DEMO_CART_FALLBACK=false
# 正式运行推荐 local_executor；商品搜索与真实加购由本地执行器直连淘宝桌面版官方 MCP。
TAOBAO_EXECUTION_BACKEND=local_executor
TAOBAO_NATIVE_MCP_URL=http://127.0.0.1:3654/mcp
# Optional override. On macOS the Worker automatically finds Taobao Desktop's bundled official CLI.
TAOBAO_NATIVE_CLI_PATH=
EXECUTOR_TAOBAO_SEARCH_TIMEOUT_MS=60000
EXECUTOR_TAOBAO_CART_TIMEOUT_MS=60000
EXECUTOR_TAOBAO_SEARCH_COOLDOWN_MS=20000
EXECUTOR_TAOBAO_AUTH_RECOVERY_POLL_MS=10000
EXECUTOR_TAOBAO_AUTH_PROBE_TIMEOUT_MS=10000
EXECUTOR_TAOBAO_READINESS_PROBE_TIMEOUT_MS=10000
EXECUTOR_TAOBAO_READINESS_BACKOFF_BASE_MS=2000
EXECUTOR_TAOBAO_READINESS_BACKOFF_MAX_MS=30000
TAOBAO_SOURCE_APP=SceneCartAI
TAOBAO_MCP_BASE_URL=
# Development-only manual MCP endpoint. Keep false for the normal product path.
SCENECART_ENABLE_MCP_DEBUG=false
RUNTIME_STORE=local
# Local development only. Formal production must use PostgreSQL.
SCENECART_LOCAL_RUNTIME_PERSIST=true
SCENECART_LOCAL_RUNTIME_PATH=
SCENECART_RETENTION_INTERVAL_HOURS=12
SCENECART_RATE_LIMIT_RETENTION_HOURS=48
SCENECART_EVENT_RETENTION_DAYS=30
SCENECART_JOB_RETENTION_DAYS=90
SCENECART_ARCHIVED_SESSION_RETENTION_DAYS=365
SCENECART_REVOKED_DEVICE_RETENTION_DAYS=180
DATABASE_URL=
DATABASE_SSL=false
# Optional PEM CA for private/self-hosted PostgreSQL. Escaped \\n sequences are supported.
DATABASE_SSL_CA=
# Development only. Formal/production runtimes reject false.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10
AUTH_REQUIRED=false
# Formal SceneCart uses one existing owner. The owner ID is server-only and must never use NEXT_PUBLIC_.
SCENECART_ACCESS_MODE=single_user
SCENECART_SINGLE_USER_ID=
# Remote fixed-owner access is fail-closed until a human verifies Vercel Deployment Protection.
# Preview accepts preview or all_deployments; Production requires all_deployments.
# Current Hobby Standard Protection does not protect the fixed Production domain: keep Production stopped.
SCENECART_OUTER_PROTECTION_VERIFIED=false
SCENECART_OUTER_PROTECTION_SCOPE=
SCENECART_OUTER_PROTECTION_VERIFIED_AT=
SCENECART_OUTER_PROTECTION_PROJECT_ID=
SCENECART_OUTER_PROTECTION_ORIGIN=
# Local path to a <=24h release receipt from live Vercel + HTTP checks. Do not deploy this file.
SCENECART_OUTER_PROTECTION_AUDIT_RECEIPT=
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:3000
# 正式站“观看 Demo”入口；只接受 HTTPS origin（本地可用 localhost HTTP）。留空使用固定公开域名。
NEXT_PUBLIC_SCENECART_PUBLIC_DEMO_URL=https://scenecart-public-demo.vercel.app
# This file documents the formal/local runtime only. The public-demo Vercel project must configure none of these values.
# Enable only when a trusted reverse proxy overwrites forwarded client-IP headers. Vercel enables this automatically.
SCENECART_TRUST_PROXY=false
# Per-IP and per-account abuse/cost limits. Keep production values finite.
SCENECART_AI_RATE_LIMIT_MINUTE_IP=30
SCENECART_AI_RATE_LIMIT_MINUTE_ACCOUNT=12
SCENECART_AI_RATE_LIMIT_DAILY_IP=500
SCENECART_AI_RATE_LIMIT_DAILY_ACCOUNT=200
SCENECART_WORKFLOW_RATE_LIMIT_MINUTE_IP=120
SCENECART_WORKFLOW_RATE_LIMIT_MINUTE_ACCOUNT=60
# Optional explicit target for npm run release:verify; defaults to APP_ORIGIN.
SCENECART_RELEASE_VERIFY_URL=
# 面试云端网页地址；供 npm run demo:cloud 使用，不含路径。
SCENECART_DEMO_CLOUD_URL=
SCENECART_CLOUD_DEVICE_TOKEN=
# 仅兼容旧 Codex hosted 开发流程；正式环境必须留空。
HOSTED_WORKER_TOKEN=
SCENECART_API_URL=http://127.0.0.1:3000
SCENECART_DEV_PORT=
# Worker-only exact protected origin. Required when the remote SceneCart deployment uses Vercel Protection.
# Do not put either value in NEXT_PUBLIC_ variables, browser code, Vercel Demo env, logs, or Git.
SCENECART_VERCEL_PROTECTED_ORIGIN=
SCENECART_VERCEL_PROTECTION_BYPASS_SECRET=
# Independent SceneCart device credential. A Vercel bypass never replaces this token.
SCENECART_DEVICE_TOKEN=
SCENECART_CRON_SECRET=
SCENECART_RECOVERY_INTERVAL_MS=30000
SCENECART_RECOVERY_STALE_MS=180000
EXECUTOR_POLL_MS=2500
EXECUTOR_API_TIMEOUT_MS=20000
EXECUTOR_RESOLVE_TIMEOUT_MS=60000
EXECUTOR_LEASE_FAILURE_LIMIT=3
# 仅在 v3 -> v4 发布排空时临时设置为未来不超过 2 小时的 ISO 时间；平时留空。
SCENECART_EXECUTOR_V4_DRAIN_UNTIL=
