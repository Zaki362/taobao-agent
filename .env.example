DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_DISABLED=false
# Optional task-level budgets for the complete HTTP response, including body reads.
DEEPSEEK_REQUEST_TIMEOUT_MS=
DEEPSEEK_PARSE_TIMEOUT_MS=15000
DEEPSEEK_PLAN_TIMEOUT_MS=26000
DEEPSEEK_REFINE_TIMEOUT_MS=18000
DEEPSEEK_PLAN_REVIEW_TIMEOUT_MS=10000
DEEPSEEK_CANDIDATE_REVIEW_TIMEOUT_MS=8000
DEEPSEEK_AGENT_DECISION_TIMEOUT_MS=8000
DEEPSEEK_AGENT_CHAT_TIMEOUT_MS=8000
DEEPSEEK_AGENT_REASONER_TIMEOUT_MS=15000
DEEPSEEK_BUNDLE_TIMEOUT_MS=12000
DEEPSEEK_EXPLAIN_TIMEOUT_MS=6000
SCENECART_PRODUCT_MODE=development
ALLOW_DEMO_CART_FALLBACK=true
# 正式运行推荐 local_executor；qoder_cli 仅用于本地调试兼容。
TAOBAO_EXECUTION_BACKEND=local_executor
QODERCLI_PATH=
TAOBAO_NATIVE_BIN=
TAOBAO_MCP_BASE_URL=
# Development-only manual MCP endpoint. Keep false for the normal product path.
SCENECART_ENABLE_MCP_DEBUG=false
RUNTIME_STORE=local
# Local development only. Formal production must use PostgreSQL.
SCENECART_LOCAL_RUNTIME_PERSIST=true
SCENECART_LOCAL_RUNTIME_PATH=
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
AUTH_REQUIRED=false
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:3000
# 仅兼容旧 Codex hosted 开发流程；正式环境必须留空。
HOSTED_WORKER_TOKEN=
SCENECART_API_URL=http://127.0.0.1:3000
SCENECART_DEV_PORT=
SCENECART_DEVICE_TOKEN=
SCENECART_CRON_SECRET=
SCENECART_RECOVERY_INTERVAL_MS=30000
SCENECART_RECOVERY_STALE_MS=180000
EXECUTOR_POLL_MS=2500
EXECUTOR_QODER_TIMEOUT_MS=180000
EXECUTOR_API_TIMEOUT_MS=20000
EXECUTOR_LEASE_FAILURE_LIMIT=3
