{
  "name": "autoprep-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev-auto.mjs",
    "dev:web": "node scripts/dev-server.mjs",
    "dev:auto": "node scripts/dev-auto.mjs",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "npm run lint:formal && npm run lint:demo",
    "lint:formal": "eslint . --max-warnings=0",
    "lint:demo": "npm --prefix apps/public-demo run lint",
    "typecheck": "npm run typecheck:formal && npm run typecheck:demo",
    "typecheck:formal": "tsc --noEmit",
    "typecheck:demo": "npm --prefix apps/public-demo run typecheck",
    "preflight": "node scripts/preflight.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "check": "npm run preflight && npm run lint && npm run typecheck && npm run build && npm run demo:build",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:check": "node scripts/db-check.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run test:e2e:formal && npm run test:e2e:public-demo",
    "test:e2e:formal": "playwright test --config playwright.config.ts",
    "test:e2e:public-demo": "playwright test --config playwright.public-demo.config.ts",
    "demo:dev": "npm --prefix apps/public-demo run dev",
    "demo:build": "npm --prefix apps/public-demo run build",
    "eval:agent": "vitest run --config vitest.evaluation.config.ts",
    "eval:agent:live": "node scripts/run-live-agent-eval.mjs",
    "worker:codex": "node scripts/codex-hosted-worker.mjs",
    "worker:local": "node scripts/local-executor.mjs",
    "worker:recovery": "node scripts/workflow-recovery-worker.mjs",
    "executor:provision": "node scripts/provision-single-user-device.mjs",
    "executor:configure": "node scripts/configure-executor.mjs",
    "executor:doctor": "node scripts/executor-doctor.mjs",
    "demo:cloud:prepare": "node scripts/prepare-cloud-demo.mjs",
    "demo:cloud:configure": "node scripts/configure-cloud-executor.mjs",
    "demo:cloud": "node scripts/demo-cloud.mjs",
    "demo:interview": "node scripts/interview-demo.mjs",
    "demo:interview:verify": "node scripts/interview-demo.mjs --verify"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "15.5.21",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "sharp": "0.35.0"
    },
    "nanoid": "3.3.18",
    "postcss": "$postcss"
  }
}
